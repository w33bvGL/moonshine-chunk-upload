{
    "name": "w33bvgl/moonshine-chunk-upload",
    "description": "Resumable, parallel chunked file upload field for the MoonShine 4 admin panel.",
    "version": "1.0.0",
    "keywords": [
        "laravel",
        "moonshine",
        "chunk-upload",
        "resumable",
        "upload"
    ],
    "type": "library",
    "homepage": "https://github.com/w33bvGL/moonshine-chunk-upload",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/w33bvGL/moonshine-chunk-upload/issues",
        "source": "https://github.com/w33bvGL/moonshine-chunk-upload"
    },
    "authors": [
        {
            "name": "w33bvgl",
            "email": "w33bvgl@gmail.com",
            "homepage": "https://github.com/w33bvGL"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "moonshine/moonshine": "^4.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "W33bvgl\\MoonShineChunkUpload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "W33bvgl\\MoonShineChunkUpload\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "W33bvgl\\MoonShineChunkUpload\\Providers\\MoonshineChunkUploadServiceProvider"
            ]
        }
    },
    "scripts": {
        "rector": ["rector process --dry-run"],
        "rector:fix": ["rector process"],
        "lint": ["pint --parallel"],
        "lint:check": ["pint --parallel --test"],
        "analyse": ["phpstan analyse --memory-limit=512M"],
        "test": ["pest"],
        "check": ["@rector:fix", "@lint", "@analyse", "@test"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
