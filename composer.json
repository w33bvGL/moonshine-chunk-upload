{
    "name": "w33bvgl/moonshine-chunk-upload",
    "description": "Resumable, parallel chunked file upload field for MoonShine admin panel",
    "keywords": [
        "laravel",
        "moonshine",
        "chunk-upload",
        "resumable"
    ],
    "type": "library",
    "homepage": "https://github.com/w33bvGL",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/w33bvGL/moonshine-chunk-upload/issues",
        "source": "https://github.com/w33bvGL/moonshine-chunk-upload"
    },
    "authors": [
        {
            "name": "w33bvgl",
            "email": "w33bvgl@gmail.com",
            "homepage": "https://github.com/w33bvGL"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "rector/rector": "^1.0|^2.0",
        "moonshine/moonshine": "^4.9"
    },
    "autoload": {
        "psr-4": {
            "W33bvgl\\MoonShineChunkUpload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "W33bvgl\\MoonShineChunkUpload\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "conflict": {
        "moonshine/moonshine": "<4.0.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "rector": "vendor/bin/rector process --clear-cache",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "W33bvgl\\MoonShineChunkUpload\\Providers\\MoonshineChunkUploadServiceProvider"
            ]
        }
    }
}
